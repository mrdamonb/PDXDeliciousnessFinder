# Supabase — copy from your project's Settings > API page
# Full URL including https://, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key — safe to expose client-side
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps — placeholder for S2 map feature; not used in S1
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
